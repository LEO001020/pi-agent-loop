{
  "name": "pi-app",
  "private": true,
  "version": "0.3.0",
  "description": "Desktop GUI for Pi — projects, sessions and packages over Pi RPC",
  "author": "Pi contributors",
  "license": "MIT",
  "homepage": "https://github.com/AJSubrizi/Pi-App",
  "repository": {
    "type": "git",
    "url": "https://github.com/AJSubrizi/Pi-App.git"
  },
  "bugs": {
    "url": "https://github.com/AJSubrizi/Pi-App/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "tauri build",
    "build:ui": "tsc -b && vite build",
    "build:mac-arm": "tauri build --target aarch64-apple-darwin",
    "build:mac-intel": "tauri build --target x86_64-apple-darwin",
    "build:mac-all": "bash scripts/build-local.sh all-mac",
    "build:win": "bash scripts/build-local.sh win",
    "build:linux": "bash scripts/build-local.sh linux",
    "build:all": "bash scripts/build-local.sh all",
    "setup:cross": "bash scripts/setup-cross-compile.sh",
    "release:tag": "bash scripts/release-tag.sh",
    "release:validate-update": "node scripts/validate-update-manifest.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@tabler/icons-react": "^3.45.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "highlight.js": "^11.11.1",
    "pdfjs-dist": "^5.4.296",
    "plyr": "^3.8.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.1.1",
    "use-stick-to-bottom": "^1.1.6",
    "xlsx": "^0.18.5",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/xlsx": "^0.0.36",
    "@vitejs/plugin-react": "^4.5.2",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
